GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Kunci acak untuk mengenkripsi sesi Auth.js, buat dengan `npx auth secret` atau `openssl rand -base64 32`
AUTH_SECRET=xxxx
# Alamat publik saat dev lewat Cloudflare Tunnel; tanpa ini callback Google memakai localhost:3000. Hapus/komentari untuk login di localhost
AUTH_URL=https://sakkarepe.dipras.my.id
# Email Google yang boleh masuk dashboard admin, pisahkan dengan koma
ADMIN_EMAILS=admin@example.com
# Wajib di production self-hosted (bukan Vercel) agar Auth.js memercayai host request
# AUTH_TRUST_HOST=true
# Nomor WhatsApp penjual untuk tombol konsultasi dan pesanan (format 62...). Dibaca saat build, jadi build ulang setelah diubah
NEXT_PUBLIC_WHATSAPP_NUMBER=6285731580488
# Database SQLite/libSQL. File lokal default; bisa juga URL Turso (libsql://...) + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/sakkarepe.db
# Folder foto unggahan admin (default storage/uploads)
# UPLOAD_DIR=storage/uploads

# DOKU Checkout untuk link pembayaran dari admin. Ambil Client ID (BRN-...) dan Secret Key (SK-...) di Back Office > Integration > API Keys; bukan API Key (doku_key_...)
# DOKU_ENV=production memakai api.doku.com; kosong/sandbox memakai api-sandbox.doku.com
# DOKU_ENV=sandbox
DOKU_SECRET_KEY=SK-xxxx
DOKU_CLIENT_ID=BRN-0276-1792724238530

# Biteship untuk cek ongkir di halaman checkout. Ambil API Key di Dashboard Biteship > Integrasi > API Keys:
# biteship_test.xxx untuk mode testing (tetap berbayar Rp5/cek ongkir), biteship_live.xxx untuk produksi
BITESHIP_API_KEY=JFEKLWJFKLEWJKL
# Kode pos asal pengiriman (default 60238, SLB Khusus Bina Mandiri) dan kurir yang ditawarkan, dipisah koma
# BITESHIP_ORIGIN_POSTAL_CODE=60238
# BITESHIP_COURIERS=jnt,jne,sicepat,anteraja,pos